# Pipeline Pulse — environment variables
#
# This demo currently runs without any required secrets.
# Copy this file to `.env` and fill in values if you wire up integrations.
#
# Lovable Cloud (uncomment when you enable Cloud in the Lovable editor):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only — never expose to the client
